<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 伴生 APK 本身没有界面入口：宿主 App 把插件类加载进自己的进程，
         用 SDK 的落点/页面注册表渲染原生界面。 -->
    <application>
        <service
            android:name=".SubscriptionPluginService"
            android:exported="true"
            android:permission="com.deepseek.dsh.permission.BIND_PLUGIN">
            <meta-data android:name="dsh.plugin.apiVersion" android:value="1" />
            <meta-data android:name="dsh.plugin.minAppVersion" android:value="12" />
            <meta-data android:name="dsh.plugin.version" android:value="${dshPluginVersion}" />
            <meta-data android:name="dsh.plugin.id" android:value="com.dsh.mobile.dsh_plugin_subscription_oauth" />
            <meta-data android:name="dsh.plugin.name" android:value="订阅" />
            <!-- 与 JS 插件 package.json 的 name 一致：App 据此配对并连带安装 JS 插件。 -->
            <meta-data android:name="dsh.plugin.jsPackage" android:value="dsh-plugin-subscription-oauth" />

            <intent-filter>
                <action android:name="com.deepseek.dsh.action.PLUGIN_UI" />
            </intent-filter>
        </service>
    </application>
</manifest>
